# --------------------------------------------------------------------------
# OPNinfer environment configuration — mainly for LOCAL DEV. Copy to `.env`
# and fill in. `.env` is git-ignored. NEVER commit real secrets.
# Generate secrets with: openssl rand -base64 32
#
# PRODUCTION does not use this file: ./deploy.sh generates one env file per
# portal instance under instances/<name>.env (git-ignored), each with its own
# secrets, database, storage and port. See README → Deploy.
# --------------------------------------------------------------------------

# Public domain your reverse proxy serves this instance on (prod). The stack
# publishes plain HTTP on APP_PORT; TLS is the reverse proxy's job.
DOMAIN="localhost"

# Base URL of the deployment (used for auth callbacks, emailed links).
AUTH_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# These feed the bundled Postgres container in docker-compose.yml.
POSTGRES_USER="opninfer"
POSTGRES_PASSWORD="opninfer"
POSTGRES_DB="opninfer"

# Prisma connection string. In Docker the host is the `db` service;
# for local dev (docker-compose.dev.yml) use localhost:5432.
#
# `connection_limit` sizes Prisma's connection pool. The default (~num_cpus*2+1)
# is small, so under many simultaneous chats requests can queue and time out.
# 15 comfortably handles 10+ concurrent users on one instance; keep it well
# below Postgres `max_connections` (default 100). `pool_timeout` (seconds) is how
# long a query waits for a free connection before erroring.
DATABASE_URL="postgresql://opninfer:opninfer@db:5432/opninfer?schema=public&connection_limit=15&pool_timeout=20"

# --- Auth & encryption (REQUIRED, 32-byte base64) ---------------------------
# Auth.js v5 session secret.
AUTH_SECRET=""

# Master key for AES-256-GCM credential encryption at rest (§6). If lost,
# stored provider keys can't be decrypted — back it up securely.
OPNINFER_MASTER_KEY=""

# --- Storage ----------------------------------------------------------------
# Tenant id scopes the on-disk storage path (§8). One org per instance in v0.1.
OPNINFER_TENANT_ID="default"
# Root directory for uploaded files (§8). A named volume in production.
OPNINFER_STORAGE_ROOT="/app/storage"
# Max upload size per file in bytes (default 50MB, §8).
OPNINFER_MAX_UPLOAD_BYTES="52428800"

# --- File ingestion engines ---------------------------------------------------
# PRODUCTION: all engines (Gotenberg + Docling OCR + Whisper STT + Kokoro TTS)
# always run, ONCE, shared by every instance (docker-compose.engines.yml;
# tunables in the server's engines.env).
# LOCAL DEV: the heavy trio is opt-in via the compose profile —
#   docker compose -f docker-compose.dev.yml --profile heavy up -d
# or uncomment for `docker compose` to pick it up automatically:
# COMPOSE_PROFILES="heavy"
# Whisper model size (tiny/base/small/medium/large-v3). Bigger = better + slower.
# WHISPER_MODEL="small"
# Live mic dictation (/api/stt). In production Docker this is set automatically
# (http://whisper:9000); for LOCAL DEV with the heavy profile running, use:
# WHISPER_URL="http://localhost:9000"
# Reply text-to-speech (/api/tts — the hover Listen button; Kokoro, heavy
# profile). In production Docker TTS_URL is set automatically
# (http://kokoro:8880); for LOCAL DEV with the heavy profile running, use:
# TTS_URL="http://localhost:8880"
# Voice (af_heart default; British: bf_emma / bm_george — see Kokoro voices).
# TTS_VOICE="af_heart"
# GPU hosts: swap the TTS image for ~35x realtime synthesis (also uncomment the
# kokoro device reservation in docker-compose.yml):
# TTS_IMAGE="ghcr.io/remsky/kokoro-fastapi-gpu:latest"

# --- Sandbox (v0.3 agentic tools) --------------------------------------------
# Shared secret between the app and the sandbox broker (deploy.sh generates
# this in production). REQUIRED for execute_command/run_script to work.
# SANDBOX_BROKER_TOKEN="<openssl rand -hex 24>"
# Local dev only — the broker runs in docker-compose.dev.yml on loopback:
# SANDBOX_BROKER_URL="http://localhost:8070"
# STORAGE_HOST_ROOT="C:/absolute/host/path/to/OPNinfer/storage"
# Sandbox internet: "egress" (default) or "none".
# SANDBOX_NETWORK="egress"

# --- Sandbox agent tier (v0.4) ------------------------------------------------
# The Sandbox capability (Admin -> Tools) runs a full Claude Code agent per
# chat inside a container managed by sandboxd. Nothing below is needed in dev:
# the defaults match docker-compose.dev.yml.
#
# Where an agent container reaches this app's credential proxy on the
# org-API-key path (the container goes back in through the host's published
# app port). Dev default: http://host.docker.internal:3000
# AGENT_PROXY_BASE="http://host.docker.internal:3000"
#
# sandboxd tunables (per container): image, memory, cpus, idle reap seconds.
# AGENT_IMAGE="opninfer-agent"
# AGENT_MEMORY="2g"
# AGENT_CPUS="2"
# AGENT_IDLE_SECONDS="1800"
#
# Subscription sign-in lives in a named volume, written by Anthropic's own
# login flow (see deploy.sh agent-login) -- never in this file.

# --- Deploy drain ------------------------------------------------------------
# Bearer token for POST/GET/DELETE /api/admin/drain, which lets an update stop
# the instance taking new turns and wait for in-flight replies to finish before
# the container is replaced (deploy.sh generates this per instance). Unset =
# the endpoint is off and updates restart abruptly, as they used to.
# OPNINFER_DEPLOY_TOKEN="<openssl rand -hex 24>"

# --- SMTP (optional) --------------------------------------------------------
# Without SMTP, invite/reset emails are logged to the server console and admins
# copy invite links directly. Can also be configured in the admin panel.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey"
# SMTP_PASS="secret"
# SMTP_FROM="OPNinfer <noreply@example.com>"

# --- Provider keys (local testing) ------------------------------------------
# NOT needed in production — admins add org keys in Admin → API. For local
# testing, paste keys here and run: node --env-file=.env --import tsx scripts/seed-keys.ts
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# Tavily (v0.3 web search/scrape tools) — free tier at https://tavily.com.
# Gemini image generation reuses GOOGLE_API_KEY; no separate key needed.
# TAVILY_API_KEY=""

# --- Dev logging ------------------------------------------------------------
# Verbose file log of everything the server does (requests, every LLM call,
# every tool call + result, all errors) → logs/dev.log. On by default in dev,
# off in production. Force with DEV_LOG=1, disable with DEV_LOG=0.
# DEV_LOG=1

# Office-to-PDF for the artifact panel (and the ingestion worker's legacy
# Office route). Provided by the gotenberg container; in dev it is published
# on loopback by docker-compose.dev.yml. Without it, Office files fall back to
# the text the ingestion worker prepared.
GOTENBERG_URL="http://localhost:3009"
